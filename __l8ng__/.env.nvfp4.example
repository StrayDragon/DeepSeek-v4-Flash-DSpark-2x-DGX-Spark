# DeepSeek V4 Flash 0731 — NVIDIA NVFP4 lane (2x DGX Spark, TP=2, DSpark MTP).
# Checkpoint: nvidia/DeepSeek-V4-Flash-0731-NVFP4 (text-only, ModelOpt
# MIXED_PRECISION: routed MoE experts in NVFP4, attn / shared expert / head /
# mtp carried as FP8). Runtime: Anemll dspark-vllm-gx10 0.1.1.
#
# This file is the whole `--env-file` for the lane; anything not listed falls
# through to the `:-` fallbacks inside __l8ng__/docker-compose.nvfp4.yml (the
# same values as .env.dspark.example). Stage-C-only VLLM_* keys are not used.
#
# Full walkthrough + the reason for every number: __l8ng__/README.md.
#
# This is the example (tracked). For a working copy:
#   cp __l8ng__/.env.nvfp4.example __l8ng__/.env.nvfp4
# __l8ng__/nvfp4.sh prefers .env.nvfp4 and falls back to this file.

# --- Cluster (this pair: head 10.0.0.1 / worker 10.0.0.2) ------------------
WORKER_HOST=10.0.0.2
# Worker checkout path. Blank mirrors the head path — both nodes are
# /home/l8ng/Kits/DeepSeek-v4-Flash-DSpark-2x-DGX-Spark, so leave it blank
# (verify with `pwd` on each node; set WORKER_DIR only if they differ).
WORKER_DIR=
WORKER_SCRIPT_DIR=
MASTER_ADDR=10.0.0.1
MASTER_PORT=25000
NODE_RANK=0
HEADLESS=
# Worker node is started by the head launcher (NODE_RANK=1 HEADLESS=1).

# --- RoCE / InfiniBand (head; the worker uses the SAME interface names) ----
# Both nodes: enp1s0f1np1 carries the CX-7 link (10.0.0.1 / 10.0.0.2), so the HCA
# is rocep1s0f1 (docs/SETUP.md) and the TCP bootstrap also runs on that link
# because MASTER_ADDR is 10.0.0.1. enP7s7 is the 192.168.123.x LAN (used only by
# the TP=3 lane); enp1s0f0np0 and enP2p1s0f0np0 are NO-CARRIER, and the second
# card's enP2p1s0f1np1 is up without an IP — none of them is selected.
NCCL_IB_HCA=rocep1s0f1
NCCL_SOCKET_IFNAME=enp1s0f1np1
TP_SOCKET_IFNAME=enp1s0f1np1
GLOO_SOCKET_IFNAME=enp1s0f1np1
# Per-node overrides when the worker's facing port differs (injected remotely).
# WORKER_NCCL_IB_HCA=rocep1s0f0
# WORKER_NCCL_SOCKET_IFNAME=enp1s0f0np0
# WORKER_TP_SOCKET_IFNAME=enp1s0f0np0
# WORKER_GLOO_SOCKET_IFNAME=enp1s0f0np0
NCCL_CROSS_NIC=1
# GID index stays auto (launcher validates sysfs per HCA, then leaves it unset).
# NCCL_IB_GID_AUTO=0
# NCCL_IB_GID_INDEX=3
# WORKER_NCCL_IB_GID_INDEX=6
# ~10x faster NCCL comm-init at high GPU-memory pressure (measured 2026-09-05
# on this lane; bandwidth unchanged). Empty = NCCL default.
# NCCL_GIN_ENABLE=0

# --- Caches / weights ------------------------------------------------------
HF_CACHE=${HOME}/.cache/huggingface   # head: /home/l8ng/.cache/huggingface
# DSPARK_WORKER_HF_NFS=0 -> prepare downloads the 163.5 GiB artifact twice.
# =1 -> the worker mounts this cache over NFSv4 on ConnectX (JIT overlays only).
# rsync scheme: explicit absolute worker cache (the launcher injects this as the
# worker's HF_CACHE), NFS off.
WORKER_HF_CACHE=/home/l8ng/.cache/huggingface
DSPARK_WORKER_HF_NFS=0
# NFS_SERVER_IP=10.0.22.1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_XET=1
# Mirror for the host-side `hf` CLI (`__l8ng__/hf-assert.sh`, and `hf download`
# of the weights). The container path is unaffected: the serve container is
# offline (HF_HUB_OFFLINE=1) and the bundled prepare's `docker run` forwards a
# fixed -e list that does not include HF_ENDPOINT.
HF_ENDPOINT=https://hf-mirror.com
# HF_HUB_DOWNLOAD_TIMEOUT=120
# HF_DOWNLOAD_WORKERS=4

# --- This lane: the NVFP4 checkpoint ---------------------------------------
# 0 = official weights, stock decoder. 1 = same weights + the gated 18 KiB
# refusal direction (keys-...-ablit terms). The direction was captured on the
# FP8 DSpark sibling of 0731, so re-check outputs after flipping.
ABLITERATED=0
DSPARK_MODEL_OFFICIAL=nvidia/DeepSeek-V4-Flash-0731-NVFP4
DSPARK_MODEL_ABLITERATED=drowzeys/keys-DeepSeekV4Flash-Vision-EXP-ablit
DSV4_ABLATE_LAMBDA=3.5
DSV4_ABLATE_LAYERS=10-42
# Tested nvidia Hub revision (tip of main at capture time). Empty = follow main.
DSPARK_REVISION=f1caa71142bd0be02f728c79f75042ac1e461579
# Empty = auto-find encoding/encoding_dsv4.py under the snapshot above.
DSPARK_ENCODING_FILE=
# Space-separated aliases; the first one is used by startup probes + smoke.
SERVED_MODEL_NAME="deepseek-v4-flash-0731-nvfp4 deepseek-v4-flash-0731"

# --- API -------------------------------------------------------------------
VLLM_HOST=0.0.0.0
VLLM_PORT=8888
VLLM_HOST_IP=10.0.0.1
WORKER_VLLM_HOST_IP=10.0.0.2
# VLLM_API_KEY=sk-single-key
# DSPARK_API_KEYS="sk-dspark-alice sk-dspark-bob"

# --- Runtime image ---------------------------------------------------------
DSPARK_VLLM_IMAGE=ghcr.io/anemll/dspark-vllm-gx10:0.1.1@sha256:a83948492cf13df455170fb42885f5ef4db54fefe0feff0f841ecbff464ac9d8

# --- Serve shape -----------------------------------------------------------
# Checkpoint facts (nvidia config.json): max_position_embeddings=1048576,
# num_hidden_layers=43, num_nextn_predict_layers=1, dspark_block_size=5.
# DSpark k must be >= 5 and, on stock config, divisible by n_predict (=1 here),
# so k=5 is the native draft depth for this checkpoint; no block-k unlock.
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=6
MAX_NUM_BATCHED_TOKENS=8192
LONG_PREFILL_TOKEN_THRESHOLD=1024
DSPARK_MAX_INFLIGHT_PREFILLS=1
# Weights are 163.49 GiB total (81.75 GiB/rank at TP=2): ~4 GiB/rank more than
# the FP8 0731 source, because NVFP4 re-writes one E4M3 scale per 16 elements
# where MXFP4 stored one E8M0 scale per 32. Weight bytes are unchanged.
# 0.835 keeps the same per-rank budget as the FP8 lanes; raise to 0.86 only if
# the boot log shows the KV pool you want with headroom left.
GPU_MEMORY_UTILIZATION_TEXT=0.835
MTP_NUM_TOKENS=5
DRAFT_SAMPLE_METHOD=probabilistic
DEFAULT_THINKING=low
# Text-only checkpoint: the flag is still passed (same chain as the 1M/6 lane)
# but is inert; the Vision-Exp image tower is not installed on this snapshot.
LIMIT_MM_PER_PROMPT=image=8

# --- Optional gates (all default 0; one variable per A/B) ------------------
# GB10 hybrid NVFP4 linear dispatcher (Marlin W4A16 for M<128, CUTLASS W4A4
# above). Only meaningful on this NVFP4 artifact. Boot does an editable
# `pip install -e` (fail-closed since 2026-09-08).
# ENABLE_VLLM_GB10_PATCH=1
# GB10_HYBRID_NVFP4_M_THRESHOLD=128
# nvidia's own card also recommends the fp4 indexer cache:
# DSPARK_ENABLE_MXFP4_INDEXER_CACHE=1
# DSPARK_ENABLE_DEEPGEMM_SM121_ALIAS=1
# DSPARK_ENABLE_ROPE_SWA_FIX=1
# DSPARK_ENABLE_DSPARK_SWA_PREFIX=1
# DSPARK_ENABLE_DSML_RECOVERY=1
# DSPARK_ENABLE_ISSUE144_EFFORT_ALIGN=1
# DSPARK_ENABLE_ISSUE136_XGRAMMAR_HOTFIX=1
# DSPARK_ENABLE_ISSUE191_TOOLCALL_FAILCLOSED=1
# DSPARK_ENABLE_ISSUE31_GPU_HOTFIX=1
# DSPARK_ENABLE_C128A_PREFILL_CACHE=1
# DSPARK_ISSUE43_SCHED_DIAG=1
# VLLM_ENABLE_RESPONSES_API_STORE=1
# DSPARK_RESPONSES_STORE_MAX_ENTRIES=256
# DSPARK_ASYNC_SCHEDULING=1
# DSPARK_SKIP_HOTFIX=0
